# Database. With Neon: DB_URL is the POOLED host, FLYWAY_URL the DIRECT host (migrations need a direct connection).
DB_URL=jdbc:postgresql://localhost:5432/trainmate
FLYWAY_URL=
DB_USER=trainmate
DB_PASSWORD=trainmate

# Redis (Upstash: rediss://default:<password>@<host>:6379). Empty uses an in-process store (one instance only).
REDIS_URL=

# Sign-in. Production is "firebase" with your Firebase project id. "dev" is refused unless DEV_TOOLS=true.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=

# Required in production: a random string of 16+ characters used to salt PNR hashes. Changing it later breaks nothing
# but means old hashes no longer match new ones.
PNR_SALT=

# Live train data. Only "mock" exists so far. See docs/train-data-provider.md.
PROVIDER=mock
PROVIDER_DAILY_BUDGET=900

# Development only. NEVER set in production: enables /api/dev/* and a movable clock.
DEV_TOOLS=false
DEV_SEED=false
